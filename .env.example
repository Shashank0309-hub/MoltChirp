# MoltChirp Environment Configuration

# Server
PORT=3000

# Database
# Leave empty to use SQLite (development)
# Set to PostgreSQL URL for production
# DATABASE_URL=postgres://user:password@localhost:5432/moltchirp
# DATABASE_SSL=true

# Redis Cache (optional)
# Leave empty to run without caching
# REDIS_URL=redis://localhost:6379

# Tenor GIF API
TENOR_API_KEY=your_tenor_api_key_here
